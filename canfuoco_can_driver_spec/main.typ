  _par("MB")
  _par("DR1")
  _par("DR2")
  _par("DR3")
  _par("DR4")
  _par("DR5")

  // _sep("Инициализация")

  // _seq("MB", "DR5", comment: "AID=110, Блок широковещательных\nсообщений")


@online{noauthor_kinematics_2022,
	title = {Kinematics of omni-directional wheeled robots},
	url = {https://gregwar.github.io/omnidirectional-wheeled-robots},
	abstract = {Omni-directional robots (sometime called holonomic robots) are platforms designed to allow a wide range of motion thanks to their wheels mechanically designed to allow lateral sliding motion. You can find such design in our open-source Robot Soccer Kit for instance. Even if less intuitive than their differential (2-wheels) counterpart, the kinematics model of such platform is arguably easier to derive, and they are easier to control since the motion is less constrained. This is what we are going to explain in detail in this post.},
	titleaddon = {Gregwar’s},
	urldate = {2025-11-25},
	date = {2022-10-30},
	langid = {american},
}

